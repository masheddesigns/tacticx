# --- Database / cache ---
DATABASE_URL=postgresql+psycopg2://bet:bet@postgres:5432/betpredictor
REDIS_URL=redis://redis:6379/0

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Football provider (API-Football via api-sports). Get key at https://www.api-football.com/ ---
FOOTBALL_PROVIDER=api_football
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# --- Odds provider (The Odds API). Get key at https://the-odds-api.com/ ---
ODDS_PROVIDER=odds_api
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_REGIONS=uk,eu
# NOTE: The Odds API has no BTTS market — valid keys include h2h, spreads, totals.
ODDS_MARKETS=h2h,totals

# --- Leagues (provider league IDs + season). Edit without code changes. ---
# Format: CODE:provider_id:season, e.g. EPL:39:2024
SUPPORTED_LEAGUES=EPL:39:2024,LA_LIGA:140:2024,SERIE_A:135:2024,BUNDESLIGA:78:2024,LIGUE_1:61:2024,UCL:2:2024

# --- Cache TTLs (seconds, configurable — never hard-code intervals in code) ---
TTL_FIXTURES_FAR=21600
TTL_FIXTURES_NEAR=3600
TTL_PRE_MATCH=900
TTL_LINEUPS=600
TTL_LIVE=30
TTL_FINISHED=86400
NEAR_KICKOFF_HOURS=24

# --- Quota protection ---
PROVIDER_MAX_REQUESTS_PER_MINUTE=25
PROVIDER_MAX_REQUESTS_PER_DAY=7000
PROVIDER_RETRY_ATTEMPTS=4
PROVIDER_RETRY_BASE_SECONDS=1.0
PROVIDER_TIMEOUT_SECONDS=20.0

# --- Workers ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Phase 1.6: source-agnostic data layer ---
# APIs are optional fallback/validation sources; bulk data comes from
# dataset/scraper adapters resolved through the source registry.
FOOTBALL_SOURCE_PRIMARY=api_football
FOOTBALL_SOURCE_FALLBACK=
ODDS_SOURCE_PRIMARY=odds_api
ODDS_SOURCE_FALLBACK=
HISTORICAL_SOURCE=csv
# Source priority for conflict reconciliation (first wins).
SOURCE_PRIORITY=api_football,football_data_co_uk,csv,odds_api

# --- Polite scraping (never bypass protections/rate limits) ---
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_MAX_REQUESTS_PER_MINUTE=20
SCRAPER_TIMEOUT_SECONDS=20.0
SCRAPER_CACHE_TTL_SECONDS=3600
SCRAPER_USER_AGENT=BetPredictor/1.6 (+personal-analysis; polite fetcher)
DATASET_BASE_URL=https://football-data.co.uk/mmz4281
# StatsBomb Open Data (public research use with attribution; raw GitHub JSON).
STATSBOMB_BASE_URL=https://raw.githubusercontent.com/statsbomb/open-data/master/data
# Local dataset cache (downloaded season files). Never committed.
DATA_DIR=data

# Explicit team-name aliases only (variant -> canonical). Deterministic,
# manually curated from real cross-source evidence — never fuzzy-matched.
TEAM_ALIASES_JSON={"Ipswich Town": "Ipswich", "Wolves": "Wolverhampton Wanderers", "Man United": "Manchester United", "Man City": "Manchester City", "Bournemouth": "AFC Bournemouth", "Leicester": "Leicester City", "Newcastle": "Newcastle United", "Tottenham": "Tottenham Hotspur", "West Ham": "West Ham United", "Ath Bilbao": "Athletic Club", "Ath Madrid": "Atlético Madrid", "Celta": "Celta Vigo", "Vallecano": "Rayo Vallecano", "Sociedad": "Real Sociedad", "Betis": "Real Betis", "Espanol": "Espanyol", "La Coruna": "RC Deportivo La Coruña", "Levante": "Levante UD", "Sp Gijon": "Sporting Gijón", "Dortmund": "Borussia Dortmund", "M'gladbach": "Borussia Mönchengladbach", "Leverkusen": "Bayer Leverkusen", "Ein Frankfurt": "Eintracht Frankfurt", "Darmstadt": "Darmstadt 98", "Mainz": "FSV Mainz 05", "Heidenheim": "FC Heidenheim", "Stuttgart": "VfB Stuttgart"}
# Explicit player-name aliases (variant -> canonical). Same rules as teams.
PLAYER_ALIASES_JSON={}

# Raw provenance payload retention (days). 0 = keep indefinitely.
RAW_RETENTION_DAYS=90
