# ==============================================================================
# TacticX Production Environment Configuration Template
# COPY TO .env OR CONFIGURE IN YOUR CONTAINER / CLOUD SECRET MANAGER
# NEVER COMMIT REAL KEYS OR CREDENTIALS
# ==============================================================================

# --- PostgreSQL Database ---
# Production MUST use PostgreSQL (never SQLite in production)
DATABASE_URL=postgresql+psycopg2://bet:bet@postgres:5432/betpredictor
POSTGRES_USER=bet
POSTGRES_PASSWORD=bet
POSTGRES_DB=betpredictor

# --- Redis (Cache & Celery Broker) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Application Environment ---
# Options: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Options: console (human readable) or json (structured production logging)
LOG_FORMAT=console
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed origins (no wildcard with credentials in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# --- Security ---
# Set to a cryptographically secure random string in production (>= 32 chars)
SECRET_KEY=dev-secret-key-change-in-production
# In production, operational mutations (job triggering, lock cleanup, provider qualification)
# default to false to protect endpoints from external web triggers. Set true only if authorized.
ENABLE_OPERATIONAL_ENDPOINTS=true
# In-memory rate limiting per client IP (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
METRICS_ENABLED=true
METRICS_INTERNAL_ONLY=true
METRICS_TOKEN=

# --- Provider Credentials (External APIs) ---
# Football data provider (API-Football): https://www.api-football.com/
FOOTBALL_PROVIDER=api_football
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io

# Odds provider (The Odds API): https://the-odds-api.com/
ODDS_PROVIDER=odds_api
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_REGIONS=uk,eu
ODDS_MARKETS=h2h,totals

# --- Competitions ---
SUPPORTED_LEAGUES=EPL:39:2024,LA_LIGA:140:2024,SERIE_A:135:2024,BUNDESLIGA:78:2024,LIGUE_1:61:2024,UCL:2:2024

# --- MiroFish Scenario Layer (Optional) ---
MIROFISH_ENABLED=false
MIROFISH_ENDPOINT=
MIROFISH_API_KEY=

# --- Phase 31: Local Continuous Production ---
# Options: development, test, local-production, production
TACTICX_ENV=local-production
# Continuous-operation switches (safe defaults: all on)
SCHEDULER_ENABLED=true
PREDICTION_ENABLED=true
EVALUATION_ENABLED=true
# Scheduler loop interval in seconds (used by `tacticx jobs run-due --loop`)
SCHEDULER_LOOP_INTERVAL_SECONDS=300
